{
    "target_overrides": {
        "*": {
            "platform.stdio-baud-rate": 115200,
            "platform.stdio-buffered-serial": 1,
            "target.semihosting-enabled": false,
            "platform.heap-stats-enabled": true,
            "platform.thread-stats-enabled": true,
            // RAM is tight (64 KB): size the stacks to what is used (see print_threads() in main.cpp)
            "events.shared-stacksize": 1024,
            "events.shared-eventsize": 512,
            "rtos.main-thread-stack-size": 2560
        },
        "LPC1768": {
            "target.components_add": ["SD"],
            // The upper half of the flash is the staging area for firmware updates from SD
            // (see src/LaosFile/firmware_update.h), so the application must fit in the lower half.
            "target.memory_bank_config": {
                "IROM1": {"size": 0x40000, "start": 0x0}
            }
        }
    }
}
